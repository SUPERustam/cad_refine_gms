RUN_NAME="rl_gms_train_sft_30682_resume_68000"

# Writable training output on scratch (sync-back target when staging is on)
BASE_DIR_SCRATCH="${REPO_ROOT}/rl_gms_train_sft_30682_resume_68000/"

# Read-only-ish inputs on scratch
CHECKPOINT_SCRATCH="${REPO_ROOT}/checkpoints/sft-30682/"
